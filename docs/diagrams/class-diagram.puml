@startuml
 title Диаграмма классов — СМО маршрутизации заказов, вариант 8
 left to right direction
 skinparam classAttributeIconSize 0
 skinparam packageStyle rectangle
 hide empty members

 package "Источники и заявки" {
   class OrderSource {
     -sourceId: int
     -priorityRank: int
     -minInterArrival: double
     -maxInterArrival: double
     +createOrder(now: double): OrderRequest
     +sampleInterArrival(): double
   }
   class OrderRequest {
     -orderId: long
     -sourceId: int
     -arrivalTime: double
     -serviceStartTime: double?
     -serviceEndTime: double?
     -status: OrderStatus
     +markQueued(): void
     +markInService(start: double): void
     +markCompleted(end: double): void
     +waitingTime(): double
     +timeInSystem(): double
   }
   enum OrderStatus {
     GENERATED
     QUEUED
     IN_SERVICE
     COMPLETED
     EVICTED
   }
   OrderSource "1" --> "0..*" OrderRequest : creates
   OrderRequest --> OrderStatus : state
 }

 package "Приём и буферизация" {
   class AdmissionDispatcher {
     -buffer: RoutingBuffer
     -overflowPolicy: OverflowPolicy
     +onOrderGenerated(order: OrderRequest): AdmissionResult
   }
   class RoutingBuffer {
     -capacity: int
     -waiting: Deque<OrderRequest>
     +isFull(): bool
     +isEmpty(): bool
     +hasFreePlace(): bool
     +enqueueTail(order: OrderRequest): void
     +removeNewestWaiting(): OrderRequest
     +getWaitingOrders(): List<OrderRequest>
     +remove(order: OrderRequest): bool
     +size(): int
   }
   interface OverflowPolicy {
     +handleFull(buffer: RoutingBuffer, incoming: OrderRequest): AdmissionResult
   }
   class EvictNewestBufferedPolicy {
     +handleFull(buffer: RoutingBuffer, incoming: OrderRequest): AdmissionResult
   }
   class AdmissionResult {
     +accepted: bool
     +evictedOrder: OrderRequest?
     +reason: string
   }
   AdmissionDispatcher --> RoutingBuffer : private buffer
   AdmissionDispatcher --> OverflowPolicy : private policy
   OverflowPolicy <|.. EvictNewestBufferedPolicy
   OverflowPolicy ..> AdmissionResult : returns
   AdmissionResult o-- "0..1" OrderRequest : evictedOrder
 }

 package "Диспетчеризация и приборы" {
   class SchedulingDispatcher {
     -buffer: RoutingBuffer
     -deviceSelector: RoundRobinDeviceSelector
     -eventCalendar: EventCalendar
     -statistics: StatisticsCollector
     +onOrderAccepted(orderId: long, now: double): void
     +onDeviceReleased(deviceId: int, now: double): void
     +dispatchAvailable(now: double): void
     -selectOrderD2B4(orders: List<OrderRequest>): OrderRequest
   }
   class RoundRobinDeviceSelector <<Д2П2>> {
     -centers: List<DistributionCenter>
     -nextIndex: int
     +findNextFreeFromPointer(): DistributionCenter?
     +markAssigned(center: DistributionCenter): void
   }
   class DistributionCenter {
     -centerId: int
     -busy: bool
     -currentOrder: OrderRequest?
     -busyTime: double
     +startService(order: OrderRequest, now: double, duration: double): void
     +finishService(now: double): OrderRequest
     +isFree(): bool
   }
   SchedulingDispatcher --> RoutingBuffer : private buffer
   SchedulingDispatcher --> RoundRobinDeviceSelector : private selector
   SchedulingDispatcher --> EventCalendar : schedules completion
   SchedulingDispatcher --> StatisticsCollector : records transitions
   RoundRobinDeviceSelector "1" o-- "1..*" DistributionCenter : centers
   DistributionCenter "0..1" --> "1" OrderRequest : currentOrder
 }

 package "События и наблюдение" {
   class SimulationEngine {
     -sources: List<OrderSource>
     -eventCalendar: EventCalendar
     -admissionDispatcher: AdmissionDispatcher
     -schedulingDispatcher: SchedulingDispatcher
     -statistics: StatisticsCollector
     -stepwiseView: StepwiseStateView
     -reportGenerator: ReportGenerator
     +runNextEvent(): void
     +handleArrival(sourceId: int, now: double): void
     +handleServiceCompletion(centerId: int, now: double): void
     +publishStepState(): void
   }
   class EventCalendar {
     -events: PriorityQueue<SimulationEvent>
     +scheduleArrival(sourceId: int, at: double): void
     +scheduleCompletion(centerId: int, orderId: long, at: double): void
     +nextEvent(): SimulationEvent
     +isEmpty(): bool
   }
   class SimulationEvent {
     +type: EventType
     +time: double
     +sourceId: int?
     +centerId: int?
     +orderId: long?
   }
   enum EventType {
     ORDER_GENERATED
     ORDER_ACCEPTED
     SERVICE_COMPLETED
     DEVICE_RELEASED
     SIMULATION_END
   }
   class StatisticsCollector {
     -generatedBySource: Map<int, long>
     -evictedBySource: Map<int, long>
     -completedBySource: Map<int, long>
     -waitingSamples: List<double>
     -serviceSamples: List<double>
     -busyTimeByCenter: Map<int, double>
     +recordGenerated(order: OrderRequest): void
     +recordEviction(order: OrderRequest): void
     +recordServiceStarted(order: OrderRequest, center: DistributionCenter, now: double): void
     +recordServiceCompleted(order: OrderRequest, center: DistributionCenter, now: double): void
     +buildSummary(): StatisticsSummary
   }
   class StepwiseStateView <<ОД2>> {
     +renderState(engine: SimulationEngine): void
   }
   class ReportGenerator <<ОР1>> {
     +buildSummaryTable(stats: StatisticsCollector): StatisticsSummary
   }
   class StatisticsSummary {
     +generatedBySource: Map<int, long>
     +rejectionProbabilityBySource: Map<int, double>
     +meanWaitingTimeBySource: Map<int, double>
     +meanServiceTimeBySource: Map<int, double>
     +meanSystemTimeBySource: Map<int, double>
     +utilizationByCenter: Map<int, double>
   }
   SimulationEngine o-- "1..*" OrderSource : sources
   SimulationEngine --> EventCalendar
   SimulationEngine --> AdmissionDispatcher
   SimulationEngine --> SchedulingDispatcher
   SimulationEngine --> StatisticsCollector
   SimulationEngine --> StepwiseStateView
   SimulationEngine --> ReportGenerator
   EventCalendar o-- "0..*" SimulationEvent
   SimulationEvent --> EventType
   ReportGenerator --> StatisticsSummary : creates
   StatisticsCollector --> StatisticsSummary : aggregates
   StatisticsCollector ..> OrderRequest : records per order
   StatisticsCollector ..> DistributionCenter : records utilization
   StepwiseStateView ..> SimulationEngine : reads current state
 }

 note bottom of AdmissionDispatcher
 ДП знает только буфер и политику переполнения.
 Он не выбирает прибор и не проверяет его занятость.
 end note
 note bottom of SchedulingDispatcher
 ДВ запускается по OrderAccepted и DeviceReleased.
 При Д2Б4 назначается одна заявка; пакет не формируется.
 end note
 note bottom of RoundRobinDeviceSelector
 Указатель перемещается на позицию после центра,
 которому успешно назначена заявка.
 end note
@enduml
